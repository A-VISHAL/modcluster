{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "ModPulse",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "modpulse.html",
        "height": "tall"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "blocks": {
    "entry": "src/devvit.ts"
  },
  "menu": {
    "items": [
      {
        "label": "Mop comments",
        "description": "Remove this comment and all child comments. This might take a few seconds to run.",
        "location": "comment",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/mop-comment"
      },
      {
        "label": "Mop post comments",
        "description": "Remove all comments of this post. This might take a few seconds to run.",
        "location": "post",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/mop-post"
      },
      {
        "label": "Create ModPulse Post",
        "description": "Creates a ModPulse custom post (Devvit Web) in this subreddit.",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/modpulse-create"
      }
    ]
  },
  "forms": {
    "mopComment": "/internal/form/mop-comment-submit",
    "mopPost": "/internal/form/mop-post-submit",
    "handoverForm": "/internal/form/handover-submit",
    "viewHandover": "/internal/form/handover-view-submit"
  },
  "triggers": {
    "onAppInstall": "/internal/triggers/on-app-install"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch"
  },
  "permissions": {
    "reddit": {
      "enable": true,
      "scope": "moderator",
      "asUser": [
        "SUBMIT_POST"
      ]
    },
    "redis": true
  },
  "dev": {
    "subreddit": "modpulse_final"
  }
}